<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>InstantConverter</AssemblyName>
    <RootNamespace>InstantConverter</RootNamespace>
    <StartupObject>InstantConverter.Program</StartupObject>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Instant Converter</Product>
    <AssemblyTitle>Instant Converter</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InstantConverter.Core\InstantConverter.Core.csproj" />
  </ItemGroup>
</Project>
